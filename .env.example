# Kopier denne fila til .env og fyll inn ekte verdier.
# .env er gitignorert og havner aldri i git.
#
# Project URL (Supabase → Project Settings → API)
SUPABASE_URL=https://DITT-PROSJEKT.supabase.co
#
# Publiserbar nøkkel (sb_publishable_…) — laget for frontend, trygg her.
# IKKE legg inn secret-nøkkelen (sb_secret_…) — den er backend-only.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_DIN-NOKKEL
#
# Service-role/secret-nøkkel (sb_secret_… / service_role JWT) — KUN server-side.
# Brukes av route handlers (bibliotek + relevante sjekkpunkt) til å lese
# datamodell/dokument_data, som har RLS begrenset til innloggede brukere;
# server-rutene har ingen brukersesjon. HEMMELIG: ALDRI eksponer til
# nettleseren og ALDRI bruk NEXT_PUBLIC-prefiks. Mangler den, faller
# funksjonene tilbake til innebygde defaults.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_DIN-NOKKEL
#
# Valgfritt — tabellnavn (standard: dokument_data)
SUPABASE_TABLE=dokument_data
#
# Base-URL til Sjekkliste-Plan-API-et som bibliotek-funksjonen henter
# datamodell-korpuset fra (server-side). Default er den publiserte Azure-
# tjenesten; sett til http://localhost:8082 når du kjører API-et lokalt.
SJEKKLISTE_API_BASE=https://ca-web-dibkplansjekk-poc.bluesea-86bb7fc5.norwayeast.azurecontainerapps.io
#
# ---------------------------------------------------------------------------
# E-postvarsler (valgfritt) — send usendte rader i `varsel`-tabellen via
# Microsoft Graph. Uten disse kjører portalen fint med kun in-app-varsler.
# ---------------------------------------------------------------------------
# Avsenderpostboks (delt postboks i M365), f.eks. varsel@arkitektum.no
VARSEL_POSTBOKS=
#
# Innlogging mot Graph — VELG ÉN:
#  a) Lokalt/dev: app-registrering i Entra ID med application-tillatelsen
#     Mail.Send (admin consent). Avgrens til postboksen med en Application
#     Access Policy i Exchange Online.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
#  b) På Azure (App Service / Container Apps): bruk Managed Identity i stedet —
#     plattformen setter IDENTITY_ENDPOINT/IDENTITY_HEADER automatisk, og
#     identiteten tildeles Graph-approllen Mail.Send. Ingen secrets trengs.
#     (Ved user-assigned identity: sett AZURE_CLIENT_ID til identitetens id.)
#
# Periodisk utsending fra serverprosessen (minutter). 0/tom = av; da kan
# POST /api/varsel-epost trigges eksternt i stedet.
VARSEL_EPOST_INTERVALL_MIN=5
#
# Delt hemmelighet for POST /api/varsel-epost (Authorization: Bearer <verdi>).
# Uten denne er endepunktet avslått (503).
VARSEL_JOBB_SECRET=
#
# Hvor gamle usendte varsler som fortsatt sendes (timer, standard 24) — hindrer
# at en gammel backlog blåses ut første gang e-post skrus på.
VARSEL_EPOST_MAKS_ALDER_TIMER=24
#
# Base-URL til portalen for dyplenker i e-postene, f.eks. https://portal.example.no
APP_URL=
